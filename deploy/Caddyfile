:80 {
	encode gzip

	# API — reverse proxy to backend
	handle /api/* {
		reverse_proxy 127.0.0.1:__BACKEND_PORT__
	}

	# Static SvelteKit build
	handle {
		root * __APP_DIR__/frontend/build

		# Los assets de /_app/immutable llevan hash en el nombre: un build nuevo
		# genera nombres nuevos, así que se pueden cachear para siempre.
		@immutable path /_app/immutable/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# index.html NO se puede cachear: es quien apunta a los bundles con hash.
		# Si el navegador se queda con una copia vieja, sigue pidiendo los assets
		# antiguos y el despliegue no se ve por mucho que el servidor esté al día.
		@html path / /index.html
		header @html Cache-Control "no-cache, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}
